[Unit]
Description=PURSUE OS Investigation Browser Service
Documentation=https://github.com/p4inz-code/pursue-os
After=pursue-runtime.service tor.service
Requires=pursue-runtime.service
Wants=tor.service

[Service]
Type=simple
User=pursue
Group=pursue-investigator
UMask=0007
ExecStart=/usr/lib/pursue/bin/pursue-browser --socket /run/pursue/ipc.sock --tor-proxy 127.0.0.1:9050
Restart=on-failure
RestartSec=5s

# Security Hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pursue/cases /var/lib/pursue/profiles /run/pursue
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
