[Unit]
Description=PURSUE OS Desktop Investigation Shell
Documentation=https://github.com/p4inz-code/pursue-os
After=pursue-runtime.service
Requires=pursue-runtime.service

[Service]
Type=simple
User=pursue-investigator
Group=pursue-investigator
UMask=0027
ExecStart=/usr/lib/pursue/bin/pursue-desktop --config /etc/pursue/config.toml
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1001

Restart=on-failure
RestartSec=5s

# Security Hardening (A-007: desktop has zero direct file/process/db access)
# Desktop communicates exclusively through IPC to the runtime service.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
